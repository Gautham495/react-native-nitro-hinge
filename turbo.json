{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".nvmrc", "pnpm-workspace.yaml"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build:android": {
      "env": ["ANDROID_HOME", "ORG_GRADLE_PROJECT_newArchEnabled"],
      "inputs": [
        "package.json",
        "android",
        "!android/.gradle",
        "!android/build",
        "!android/app/build",
        "$TURBO_ROOT$/packages/react-native-nitro-hinge/package.json",
        "$TURBO_ROOT$/packages/react-native-nitro-hinge/android",
        "!$TURBO_ROOT$/packages/react-native-nitro-hinge/android/build",
        "!$TURBO_ROOT$/packages/react-native-nitro-hinge/android/.cxx",
        "$TURBO_ROOT$/packages/react-native-nitro-hinge/nitro.json",
        "$TURBO_ROOT$/packages/react-native-nitro-hinge/nitrogen",
        "$TURBO_ROOT$/packages/react-native-nitro-hinge/src/*.ts",
        "$TURBO_ROOT$/packages/react-native-nitro-hinge/src/*.tsx"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": [
        "RCT_NEW_ARCH_ENABLED",
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "package.json",
        "ios",
        "!ios/build",
        "!ios/Pods",
        "$TURBO_ROOT$/packages/react-native-nitro-hinge/package.json",
        "$TURBO_ROOT$/packages/react-native-nitro-hinge/*.podspec",
        "$TURBO_ROOT$/packages/react-native-nitro-hinge/ios",
        "!$TURBO_ROOT$/packages/react-native-nitro-hinge/ios/build",
        "$TURBO_ROOT$/packages/react-native-nitro-hinge/nitro.json",
        "$TURBO_ROOT$/packages/react-native-nitro-hinge/nitrogen",
        "$TURBO_ROOT$/packages/react-native-nitro-hinge/src/*.ts",
        "$TURBO_ROOT$/packages/react-native-nitro-hinge/src/*.tsx"
      ],
      "outputs": []
    }
  }
}
