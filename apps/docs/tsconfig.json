{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // @docusaurus/tsconfig still sets baseUrl, which TypeScript 6 rejects.
    // Without it, paths resolve from the file that declares them, so @site/*
    // is declared again here.
    "baseUrl": null,
    "paths": {
      "@site/*": ["./*"]
    }
  },
  "exclude": [".docusaurus", "build"]
}
