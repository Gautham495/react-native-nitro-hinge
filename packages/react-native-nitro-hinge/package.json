{
  "name": "react-native-nitro-hinge",
  "version": "2.0.6",
  "description": "Native size class, safe insets, and hinge geometry for React Native. Nitro-backed. iOS + Android. One API for phones, tablets, foldables, tri-folds, iPhone Duo — and whatever ships next.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-nitro-hinge-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./reanimated": {
      "react-native-nitro-hinge-source": "./src/reanimated.ts",
      "types": "./lib/typescript/src/reanimated.d.ts",
      "default": "./lib/module/reanimated.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "skills",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "prepare": "bob build",
    "prepack": "rm -rf skills && cp -R ../../skills ../../README.md ../../LICENSE .",
    "nitrogen": "nitrogen",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "hinge",
    "fold",
    "duo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gautham495/react-native-nitro-hinge.git"
  },
  "author": "Gautham Vijayan <kinggautham495@gmail.com> (https://github.com/Gautham495)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Gautham495/react-native-nitro-hinge/issues"
  },
  "homepage": "https://github.com/Gautham495/react-native-nitro-hinge#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "^19.2.0",
    "jest": "^29.7.0",
    "nitrogen": "^0.37.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.1",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "^4.7.1",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "^0.13.1",
    "test-renderer": "^1.3.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*",
    "react-native-reanimated": "*",
    "react-native-worklets": "*"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "<%- project.sourceCondition -%>"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ]
  },
  "create-react-native-library": {
    "type": "nitro-module",
    "languages": "kotlin-swift",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it",
      "vite"
    ],
    "version": "0.63.1"
  }
}
