{
  "name": "react-native-nitro-hinge-monorepo",
  "private": true,
  "scripts": {
    "example": "pnpm --filter react-native-nitro-hinge-example",
    "clean": "del-cli packages/react-native-nitro-hinge/android/build packages/react-native-nitro-hinge/lib apps/example/android/build apps/example/android/app/build apps/example/ios/build",
    "nitrogen": "pnpm --filter react-native-nitro-hinge nitrogen",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "pnpm --filter react-native-nitro-hinge test",
    "test:android": "cd apps/example/android && ./gradlew :react-native-nitro-hinge:testDebugUnitTest",
    "release": "pnpm --filter react-native-nitro-hinge release"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@react-native/eslint-config": "0.86.2",
    "commitlint": "^21.2.1",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.18.0",
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
